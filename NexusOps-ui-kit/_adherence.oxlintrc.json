      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|solid|danger)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'solid' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|tone|mono|title|style|key|ref|className|style|children)$/]",
        "message": "<MetaChip> doesn't accept that prop. Declared props: children, icon, tone, mono, title, style."
