{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badges/**",
              "components/controls/**",
              "components/objects/**",
              "components/status/**",
              "ui_kits/control-plane/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AttentionMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|variant|style|key|ref|className|style|children)$/]",
        "message": "<AttentionMarker> doesn't accept that prop. Declared props: level, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AttentionMarker'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:rail|dot)$/]",
        "message": "<AttentionMarker> variant must be one of 'rail' | 'dot'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|variant|mono|icon|size|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, variant, mono, icon, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|solid|outline|dot)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'solid' | 'outline' | 'dot'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md)$/]",
        "message": "<Badge> size must be one of 'xs' | 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|disabled|loading|full|kbd|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, disabled, loading, full, kbd, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|outline|danger|brain)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'outline' | 'danger' | 'brain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiffLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|text|ln|key|ref|className|style|children)$/]",
        "message": "<DiffLine> doesn't accept that prop. Declared props: type, text, ln."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiffLine'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:add|del|ctx)$/]",
        "message": "<DiffLine> type must be one of 'add' | 'del' | 'ctx'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|sub|freshness|onClick|style|key|ref|className|style|children)$/]",
        "message": "<EvidenceChip> doesn't accept that prop. Declared props: kind, label, sub, freshness, onClick, style."
