        "selector": "JSXOpeningElement[name.name='HarnessBadge'] > JSXAttribute[name.name='harness'] > Literal[value!=/^(?:claude-code|codex-cli|codex-cloud|shell)$/]",
        "message": "<HarnessBadge> harness must be one of 'claude-code' | 'codex-cli' | 'codex-cloud' | 'shell'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|size|variant|active|disabled|badge|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, label, size, variant, active, disabled, badge, onClick, style."
