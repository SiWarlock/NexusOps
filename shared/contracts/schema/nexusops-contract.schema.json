{
  "$defs": {
    "ActionRequest": {
      "description": "ActionRequest (15, R-5, NEW) — the execution-lifecycle axis.",
      "enum": [
        "submitted",
        "previewed",
        "policy_decided",
        "awaiting_approval",
        "approved",
        "denied",
        "queued",
        "executing",
