    "WorktreeGit": {
      "description": "Worktree git-sync axis (R-7). No terminal states (the overlay axis carries\nthe terminal `deleted`).",
      "enum": [
        "clean",
        "dirty",
        "untracked_files",
        "conflicts",
        "behind_base",
        "ahead_of_base"
      ],
      "type": "string"
    },
    "WorktreeOverlay": {
      "description": "Worktree lifecycle-overlay axis (R-7).",
      "enum": [
        "creating",
        "locked",
        "pr_open",
        "merged",
        "prunable",
        "deleted"
      ],
      "type": "string"
    }
