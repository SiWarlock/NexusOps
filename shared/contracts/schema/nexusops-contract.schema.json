{
  "$defs": {
    "ActionRequest": {
      "description": "ActionRequest (15, R-5, NEW) — the execution-lifecycle axis.",
      "enum": [
        "submitted",
        "previewed",
        "policy_decided",
        "awaiting_approval",
        "approved",
        "denied",
        "queued",
        "executing",
        "succeeded",
        "failed",
        "partially_succeeded",
        "rolled_back",
        "rollback_failed",
        "cancelled",
        "expired"
      ],
      "type": "string"
    },
    "ActorType": {
      "description": "The 10 canonical audit actors (R-2). Serialized as snake_case `TEXT`.",
      "enum": [
        "user",
        "project_brain",
        "action_gateway",
        "workflow_runtime",
        "local_runner",
        "session_adapter",
        "integration_syncer",
        "system",
        "remote_client",
        "automation_policy"
      ],
      "type": "string"
    },
    "AgentTeam": {
      "description": "AgentTeam (9, R-6).",
      "enum": [
        "draft",
        "starting",
        "active",
        "waiting_on_human",
        "blocked",
        "reconciling_outputs",
        "completed",
        "failed",
        "archived"
      ],
      "type": "string"
    },
    "Approval": {
      "description": "Approval (10, R-5) — split from ActionRequest; the human/policy decision axis.",
      "enum": [
        "requested",
        "previewed",
        "awaiting_approval",
        "approved",
        "denied",
        "edited",
        "auto_approved_by_policy",
        "expired",
        "cancelled",
        "escalated"
      ],
      "type": "string"
    },
    "AuditIntegrityViolation": {
      "additionalProperties": false,
      "description": "`AuditIntegrityViolation` payload (§17 Option C). Emitted when startup replay QUARANTINES a\ncorrupt / unredacted event row — the LOUD, consumer-visible record that the audit history has\na gap (the core of why Option C beats a silent skip). Carries the affected `seq` + a\nredaction-safe **structural** `reason` — NEVER the corrupt payload or any row content (§15).",
      "properties": {
        "reason": {
          "type": "string"
        },
        "seq": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "reason"
      ],
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "description": "`get_capabilities` / `HelloAck` capabilities (§6.4). Matches the ui's pinned `Capabilities`\n(`protocol_version` + `contract_version`).",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocol_version",
        "contract_version"
      ],
      "type": "object"
    },
    "DeltaKind": {
      "description": "The kind of projection change in a [`ProjectionDelta`] (§6.1). snake_case wire values.",
      "enum": [
        "upsert",
        "remove"
      ],
      "type": "string"
    },
    "DesktopObjectKind": {
      "description": "The 4 desktop-addendum object kinds (§5.3). Serialized snake_case.",
      "enum": [
        "local_runner",
        "event_projection",
        "device",
        "remote_client"
      ],
      "type": "string"
    },
    "DeviceId": {
      "description": "`dev_<ULID>` — the registered desktop host (§5.3 Device; trust-boundary anchor).\nRegister-if-absent: minted once, reused across restarts.",
      "type": "string"
    },
    "DeviceRegistered": {
      "additionalProperties": false,
      "description": "`DeviceRegistered` payload (§5.3 Device / §16 bootstrap). The device's `dev_` identity is\nNOT an envelope typed column, so it lives in the payload — the `object_refs` projector\nsources the edge from here (the payload is the identity home; rebuild-safe). Register-if-\nabsent: the stable desktop host registers once and is reused across daemon restarts.",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/DeviceId"
        }
      },
      "required": [
        "device_id"
      ],
      "type": "object"
    },
    "EventEnvelope": {
      "additionalProperties": false,
      "description": "The §7.1 Event envelope. `seq` is the canonical total order (not `occurred_at`;\nclocks skew — both kept). Required fields are non-`Option`; the rest are optional\nper §7.1. `payload_hash`/`previous_event_hash` are reserved (R-10).\n`redaction_status` carries the §15 redaction state (the writer GATE enforces\n`redacted` before persist — `daemon::eventstore`).",
      "properties": {
        "action_request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor_id": {
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "agent_team_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "causation_id": {
          "description": "the immediate prior event_id (typed as the frozen newtype, per §2.1)",
          "type": [
            "string",
            "null"
          ]
        },
        "correlation_id": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "event_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "object_refs": {
          "description": "optional (§7.1) — omitted when empty, so the schema does not mark it required",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "type": "array"
        },
        "occurred_at": {
          "type": "string"
        },
        "payload_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload_json": {
          "type": "string"
        },
        "previous_event_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "type": "string"
        },
        "redaction_engine_version": {
          "description": "which Redactor engine redacted the payload (provenance; e.g. `prefix-v1`;\ndistinguishes 1.1 prefix-redacted from 1.7 entropy-redacted events)",
          "type": [
            "string",
            "null"
          ]
        },
        "redaction_status": {
          "$ref": "#/$defs/RedactionStatus",
          "description": "§15 redaction-before-persist state (writer gate enforces `redacted`)"
        },
        "schema_version": {
          "type": "string"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "seq": {
          "format": "int64",
          "type": "integer"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "visibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Visibility"
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "seq",
        "event_type",
        "event_version",
        "occurred_at",
        "recorded_at",
        "workspace_id",
        "actor_type",
        "actor_id",
        "source_type",
        "source_id",
        "correlation_id",
        "sensitivity",
        "redaction_status",
        "payload_json",
        "schema_version"
      ],
      "type": "object"
    },
    "GetProjectionParams": {
      "additionalProperties": false,
      "description": "`get_projection` params (§6.1). `page` (pagination) is provisional and omitted for MVP.\n\n**MVP NOTE:** `scope` is **accepted but NOT YET enforced** — the daemon returns the full\nprojection table regardless of `scope.project_id` (the local same-uid peer has no tenancy\nboundary in MVP). Do not build client filtering that assumes the daemon honors `scope`;\nscope filtering (and the `ProjectId` newtype on the field) land when multi-project scoping does.",
      "properties": {
        "name": {
          "$ref": "#/$defs/ProjectionName"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectionScope"
            },
            {
              "type": "null"
            }
          ],
          "description": "accepted but not yet enforced (see the struct note) — the read is unscoped in MVP."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "HelloAck": {
      "additionalProperties": false,
      "description": "daemon→client handshake success (§6.4): the negotiated protocol version + the daemon's\nbuild version + its capabilities.",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "daemon_version": {
          "type": "string"
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocol_version",
        "daemon_version",
        "capabilities"
      ],
      "type": "object"
    },
    "HelloFrame": {
      "additionalProperties": false,
      "description": "The first client→daemon frame (§6.4 handshake). No method is served until a successful\nhandshake. `deny_unknown_fields` rejects a non-Hello first frame (reject-unknown, §15).",
      "properties": {
        "app_version": {
          "type": "string"
        },
        "client_kind": {
          "type": "string"
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocol_version",
        "client_kind",
        "app_version"
      ],
      "type": "object"
    },
    "IdKind": {
      "description": "The 22 shared ID kinds (§5.2). Serialized snake_case (== the ID field name).",
      "enum": [
        "workspace_id",
        "project_id",
        "repo_id",
        "worktree_id",
        "branch_name",
        "commit_sha",
        "session_id",
        "agent_team_id",
        "execution_profile_id",
        "workflow_pack_id",
        "workflow_instance_id",
        "workflow_command_id",
        "implementation_plan_id",
        "plan_task_id",
        "architecture_anchor",
        "linear_issue_id",
        "github_issue_number",
        "pr_number",
        "action_request_id",
        "event_id",
        "artifact_id",
        "evidence_item_id"
      ],
      "type": "string"
    },
    "IpcErrorCode": {
      "description": "The §6.4 structured wire error codes (closed set; reject-unknown). snake_case wire values.\n`protocol_error` (a bad-first-frame / handshake-required / malformed-frame violation, distinct\nfrom `unknown_method`) was added in 1.5 per the lead-ratified §6.4 gap resolution (Option B).",
      "enum": [
        "version_skew",
        "frame_too_large",
        "unknown_method",
        "unauthorized_peer",
        "policy_denied",
        "precondition_stale",
        "protocol_error"
      ],
      "type": "string"
    },
    "LocalRunnerId": {
      "description": "`lr_<ULID>` — a daemon execution surface (§5.3 LocalRunner), minted per daemon start.",
      "type": "string"
    },
    "LocalRunnerRegistered": {
      "additionalProperties": false,
      "description": "`LocalRunnerRegistered` payload (§5.3 LocalRunner / §16 bootstrap). Minted fresh per\ndaemon start; the `lr_` identity lives in the payload (not an envelope column) so the\n`object_refs` projector sources the edge from it (rebuild-safe).",
      "properties": {
        "local_runner_id": {
          "$ref": "#/$defs/LocalRunnerId"
        }
      },
      "required": [
        "local_runner_id"
      ],
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "description": "A normalized event→object edge (`object_refs[]`, §7.1 / DATA_MODEL §2.2).",
      "properties": {
        "object_id": {
          "type": "string"
        },
        "object_type": {
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id"
      ],
      "type": "object"
    },
    "ProjectBrain": {
      "description": "ProjectBrain (10) — daemon-cached last-reported sidecar status (§7.2).",
      "enum": [
        "not_configured",
        "indexing",
        "ready",
        "partial_index",
        "stale",
        "graph_degraded",
        "transcript_ingestion_off",
        "transcript_ingestion_active",
        "reindex_required",
        "error"
      ],
      "type": "string"
    },
    "ProjectionDelta": {
      "additionalProperties": false,
      "description": "A streamed projection delta (§6.1 subscribe) — matches the ui's `ProjectionDelta`: the changed\nprojection, the change kind, and the row (on upsert) or just the id (on remove).",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/DeltaKind"
        },
        "projection": {
          "$ref": "#/$defs/ProjectionName",
          "description": "the changed projection (closed enum — reject-unknown both ways; serializes to the same\nPascalCase string the ui's `ProjectionDelta` parses, but the daemon can't push a typo)."
        },
        "row": true
      },
      "required": [
        "projection",
        "kind"
      ],
      "type": "object"
    },
    "ProjectionName": {
      "description": "The canonical closed projection-name enum (§6.1) — both daemon + ui reject-unknown. **Wire\nvalues are PascalCase** (the variant names verbatim — NO `rename_all`), matching the ui's\npinned `get_projection(\"Session\"|…)` literals + the §7 registry / R-5/R-6 architecture labels.\n`UsageLedger` is the architecture-canonical name (the ui's provisional `Usage` reconciles to it).",
      "enum": [
        "ProjectActivity",
        "Session",
        "ApprovalQueue",
        "Worktree",
        "PullRequest",
        "PlanProgress",
        "ProjectGraph",
        "AgentTeam",
        "AuditTrail",
        "UsageLedger"
      ],
      "type": "string"
    },
    "ProjectionScope": {
      "additionalProperties": false,
      "description": "`get_projection` scope filter (§6.1; provisional — widens as scoping lands).",
      "properties": {
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PullRequest": {
      "description": "PullRequest (11) — GitHub-authoritative cache (§7.2).",
      "enum": [
        "draft",
        "open",
        "checks_pending",
        "checks_failing",
        "needs_review",
        "changes_requested",
        "approved",
        "mergeable",
        "conflict",
        "merged",
        "closed"
      ],
      "type": "string"
    },
    "RedactionStatus": {
      "description": "§15 redaction state. The single-writer GATE refuses to persist any event\nthat is not `redacted`. A quarantined (unredactable) event is diverted —\nnot persisted — and a `SensitiveOutputRedacted` event recorded instead, so\nonly these 2 values ever reach the `events` table.",
      "enum": [
        "unredacted",
        "redacted"
      ],
      "type": "string"
    },
    "RpcRequest": {
      "additionalProperties": false,
      "description": "A JSON-RPC-style method request (§6.1). `id` correlates the response; `params` is the\nmethod-specific argument object (the daemon validates it per-method).",
      "properties": {
        "id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "default": null
        }
      },
      "required": [
        "method",
        "id"
      ],
      "type": "object"
    },
    "RpcResponse": {
      "additionalProperties": false,
      "description": "A JSON-RPC-style response (§6.1), correlated by `id`: exactly one of `result` / `error`.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "result": true
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Sensitivity": {
      "description": "§7.1/§15 sensitivity classification (EM §9). Terminal output defaults `restricted`.",
      "enum": [
        "public",
        "internal",
        "confidential",
        "secret",
        "restricted"
      ],
      "type": "string"
    },
    "ServerFrame": {
      "description": "The server→client **multiplexed frame envelope** (§6.4 frame-type tag). The internally-tagged\n`frame_type` discriminant lets the client demultiplex one connection: an RPC response vs a\nsubscription push. The **Terminal-Channel tag space is RESERVED** — raw PTY frames are a\nPhase-3 decision (JSON-base64 vs a binary fast-path, made with throughput data); no variant yet.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A JSON-RPC-style response (§6.1), correlated by `id`: exactly one of `result` / `error`.",
          "properties": {
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WireError"
                },
                {
                  "type": "null"
                }
              ]
            },
            "frame_type": {
              "const": "rpc_response",
              "type": "string"
            },
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "result": true
          },
          "required": [
            "frame_type",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A streamed projection delta (§6.1 subscribe) — matches the ui's `ProjectionDelta`: the changed\nprojection, the change kind, and the row (on upsert) or just the id (on remove).",
          "properties": {
            "frame_type": {
              "const": "subscription_push",
              "type": "string"
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "$ref": "#/$defs/DeltaKind"
            },
            "projection": {
              "$ref": "#/$defs/ProjectionName",
              "description": "the changed projection (closed enum — reject-unknown both ways; serializes to the same\nPascalCase string the ui's `ProjectionDelta` parses, but the daemon can't push a typo)."
            },
            "row": true
          },
          "required": [
            "frame_type",
            "projection",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Session": {
      "description": "Session lifecycle (17, R-4) — the driver-agnostic normalized vocabulary the\n§9.1 harness adapters map INTO. `stale` is time-derived (§5.1).",
      "enum": [
        "creating",
        "starting",
        "active",
        "thinking",
        "running_command",
        "editing_files",
        "running_tests",
        "waiting_on_permission",
        "waiting_on_human_input",
        "waiting_on_external_service",
        "idle",
        "stale",
        "changes_ready",
        "failed",
        "completed",
        "archived",
        "killed"
      ],
      "type": "string"
    },
    "SessionStarted": {
      "additionalProperties": false,
      "description": "`SessionStarted` payload. The session's **identity** (`session_id`/`project_id`)\nlives on the [`crate::event_envelope::EventEnvelope`] typed fields (so projectors\nderive `object_refs` + read-models from columns that survive a rebuild); this\npayload carries the type-specific session attributes the `proj_session` projector\nfolds. `status` binds to the frozen §5.1 [`Session`] machine — an unknown wire\nvalue fails closed at the parse boundary (reject-unknown, §15).",
      "properties": {
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/Session"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "SourceType": {
      "description": "EM §8 source model — the subsystem that emitted the event (CLOSED MVP set, 15).",
      "enum": [
        "desktop_ui",
        "local_daemon",
        "action_gateway",
        "terminal_supervisor",
        "claude_code_adapter",
        "codex_adapter",
        "git_executor",
        "github_syncer",
        "linear_syncer",
        "workflow_pack_runtime",
        "project_brain_indexer",
        "project_brain_retriever",
        "project_brain_action_planner",
        "usage_meter",
        "remote_relay"
      ],
      "type": "string"
    },
    "SubscribeParams": {
      "additionalProperties": false,
      "description": "`subscribe` params (§6.1). `filter` is provisional (a per-projection scope; widens later).",
      "properties": {
        "filter": true,
        "projection": {
          "$ref": "#/$defs/ProjectionName"
        }
      },
      "required": [
        "projection"
      ],
      "type": "object"
    },
    "Task": {
      "description": "Task / PlanTask superset (17, R-8).",
      "enum": [
        "unassigned",
        "queued",
        "assigned",
        "ready",
        "in_progress",
        "blocked",
        "needs_clarification",
        "in_review",
        "changes_ready",
        "pr_opened",
        "needs_review",
        "requested_changes",
        "done",
        "deferred",
        "merged",
        "closed",
        "abandoned"
      ],
      "type": "string"
    },
    "VersionSkewError": {
      "additionalProperties": false,
      "description": "daemon→client handshake failure on version skew (§6.4): the daemon's supported range + the\nclient's offered version, so the ui can render \"update required\" (its `update_required` path).",
      "properties": {
        "client_protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "supported_max": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "supported_min": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "supported_min",
        "supported_max",
        "client_protocol_version"
      ],
      "type": "object"
    },
    "Visibility": {
      "description": "§7.1 visibility scope.",
      "enum": [
        "user",
        "project",
        "workspace",
        "system"
      ],
      "type": "string"
    },
    "WireError": {
      "additionalProperties": false,
      "description": "A structured daemon→client error frame (§6.4). Carries one of the closed [`IpcErrorCode`]s.",
      "properties": {
        "code": {
          "$ref": "#/$defs/IpcErrorCode"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "WorkflowInstance": {
      "description": "WorkflowInstance (12, R-7).",
      "enum": [
        "not_detected",
        "pack_available",
        "needs_personalization",
        "personalization_in_progress",
        "generated_review_required",
        "active",
        "ready_for_team_run",
        "degraded",
        "drift_detected",
        "upgrade_available",
        "archived",
        "detached"
      ],
      "type": "string"
    },
    "WorktreeGit": {
