{
  "$defs": {
    "ActionRequest": {
      "description": "ActionRequest (15, R-5, NEW) — the execution-lifecycle axis.",
      "enum": [
        "submitted",
        "previewed",
        "policy_decided",
        "awaiting_approval",
        "approved",
        "denied",
        "queued",
        "executing",
        "succeeded",
        "failed",
        "partially_succeeded",
        "rolled_back",
        "rollback_failed",
        "cancelled",
        "expired"
      ],
      "type": "string"
    },
    "ActorType": {
      "description": "The 10 canonical audit actors (R-2). Serialized as snake_case `TEXT`.",
      "enum": [
        "user",
        "project_brain",
        "action_gateway",
        "workflow_runtime",
        "local_runner",
        "session_adapter",
        "integration_syncer",
        "system",
        "remote_client",
        "automation_policy"
      ],
      "type": "string"
    },
    "AgentTeam": {
      "description": "AgentTeam (9, R-6).",
      "enum": [
        "draft",
        "starting",
        "active",
        "waiting_on_human",
        "blocked",
        "reconciling_outputs",
        "completed",
        "failed",
        "archived"
      ],
      "type": "string"
    },
    "Approval": {
      "description": "Approval (10, R-5) — split from ActionRequest; the human/policy decision axis.",
      "enum": [
        "requested",
        "previewed",
        "awaiting_approval",
        "approved",
        "denied",
        "edited",
        "auto_approved_by_policy",
        "expired",
        "cancelled",
        "escalated"
      ],
      "type": "string"
    },
    "DesktopObjectKind": {
      "description": "The 4 desktop-addendum object kinds (§5.3). Serialized snake_case.",
      "enum": [
        "local_runner",
        "event_projection",
        "device",
        "remote_client"
      ],
      "type": "string"
    },
    "EventEnvelope": {
      "additionalProperties": false,
      "description": "The §7.1 Event envelope. `seq` is the canonical total order (not `occurred_at`;\nclocks skew — both kept). Required fields are non-`Option`; the rest are optional\nper §7.1. `payload_hash`/`previous_event_hash` are reserved (R-10).\n`redaction_status` carries the §15 redaction state (the writer GATE enforces\n`redacted` before persist — `daemon::eventstore`).",
      "properties": {
        "action_request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor_id": {
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "agent_team_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "causation_id": {
          "description": "the immediate prior event_id (typed as the frozen newtype, per §2.1)",
          "type": [
            "string",
            "null"
          ]
        },
        "correlation_id": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "event_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "object_refs": {
          "description": "optional (§7.1) — omitted when empty, so the schema does not mark it required",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "type": "array"
        },
        "occurred_at": {
          "type": "string"
        },
        "payload_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload_json": {
          "type": "string"
        },
        "previous_event_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "type": "string"
        },
        "redaction_engine_version": {
          "description": "which Redactor engine redacted the payload (provenance; e.g. `prefix-v1`;\ndistinguishes 1.1 prefix-redacted from 1.7 entropy-redacted events)",
          "type": [
            "string",
            "null"
          ]
        },
        "redaction_status": {
          "$ref": "#/$defs/RedactionStatus",
          "description": "§15 redaction-before-persist state (writer gate enforces `redacted`)"
        },
        "schema_version": {
          "type": "string"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "seq": {
          "format": "int64",
          "type": "integer"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "visibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Visibility"
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "seq",
        "event_type",
        "event_version",
        "occurred_at",
        "recorded_at",
        "workspace_id",
        "actor_type",
        "actor_id",
        "source_type",
        "source_id",
        "correlation_id",
        "sensitivity",
        "redaction_status",
        "payload_json",
        "schema_version"
      ],
      "type": "object"
    },
    "IdKind": {
      "description": "The 22 shared ID kinds (§5.2). Serialized snake_case (== the ID field name).",
      "enum": [
        "workspace_id",
        "project_id",
        "repo_id",
        "worktree_id",
        "branch_name",
        "commit_sha",
        "session_id",
        "agent_team_id",
        "execution_profile_id",
        "workflow_pack_id",
        "workflow_instance_id",
        "workflow_command_id",
        "implementation_plan_id",
        "plan_task_id",
        "architecture_anchor",
        "linear_issue_id",
        "github_issue_number",
        "pr_number",
        "action_request_id",
        "event_id",
        "artifact_id",
        "evidence_item_id"
      ],
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "description": "A normalized event→object edge (`object_refs[]`, §7.1 / DATA_MODEL §2.2).",
      "properties": {
        "object_id": {
          "type": "string"
        },
        "object_type": {
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id"
      ],
      "type": "object"
    },
    "ProjectBrain": {
      "description": "ProjectBrain (10) — daemon-cached last-reported sidecar status (§7.2).",
      "enum": [
        "not_configured",
        "indexing",
        "ready",
        "partial_index",
        "stale",
        "graph_degraded",
        "transcript_ingestion_off",
        "transcript_ingestion_active",
        "reindex_required",
        "error"
      ],
      "type": "string"
    },
    "PullRequest": {
      "description": "PullRequest (11) — GitHub-authoritative cache (§7.2).",
      "enum": [
        "draft",
        "open",
        "checks_pending",
        "checks_failing",
        "needs_review",
        "changes_requested",
        "approved",
        "mergeable",
        "conflict",
        "merged",
        "closed"
      ],
      "type": "string"
    },
    "RedactionStatus": {
      "description": "§15 redaction state. The single-writer GATE refuses to persist any event\nthat is not `redacted`. A quarantined (unredactable) event is diverted —\nnot persisted — and a `SensitiveOutputRedacted` event recorded instead, so\nonly these 2 values ever reach the `events` table.",
      "enum": [
        "unredacted",
        "redacted"
      ],
      "type": "string"
    },
    "Sensitivity": {
      "description": "§7.1/§15 sensitivity classification (EM §9). Terminal output defaults `restricted`.",
      "enum": [
        "public",
        "internal",
        "confidential",
        "secret",
        "restricted"
      ],
      "type": "string"
    },
    "Session": {
      "description": "Session lifecycle (17, R-4) — the driver-agnostic normalized vocabulary the\n§9.1 harness adapters map INTO. `stale` is time-derived (§5.1).",
      "enum": [
        "creating",
        "starting",
        "active",
        "thinking",
        "running_command",
        "editing_files",
        "running_tests",
        "waiting_on_permission",
        "waiting_on_human_input",
        "waiting_on_external_service",
        "idle",
        "stale",
        "changes_ready",
        "failed",
        "completed",
        "archived",
        "killed"
      ],
      "type": "string"
    },
    "SessionStarted": {
      "additionalProperties": false,
      "description": "`SessionStarted` payload. The session's **identity** (`session_id`/`project_id`)\nlives on the [`crate::event_envelope::EventEnvelope`] typed fields (so projectors\nderive `object_refs` + read-models from columns that survive a rebuild); this\npayload carries the type-specific session attributes the `proj_session` projector\nfolds. `status` binds to the frozen §5.1 [`Session`] machine — an unknown wire\nvalue fails closed at the parse boundary (reject-unknown, §15).",
      "properties": {
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/Session"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "SourceType": {
      "description": "EM §8 source model — the subsystem that emitted the event (CLOSED MVP set, 15).",
      "enum": [
        "desktop_ui",
        "local_daemon",
        "action_gateway",
        "terminal_supervisor",
        "claude_code_adapter",
        "codex_adapter",
        "git_executor",
        "github_syncer",
        "linear_syncer",
        "workflow_pack_runtime",
        "project_brain_indexer",
        "project_brain_retriever",
        "project_brain_action_planner",
        "usage_meter",
        "remote_relay"
      ],
      "type": "string"
    },
    "Task": {
      "description": "Task / PlanTask superset (17, R-8).",
      "enum": [
        "unassigned",
        "queued",
        "assigned",
        "ready",
        "in_progress",
        "blocked",
        "needs_clarification",
        "in_review",
        "changes_ready",
        "pr_opened",
        "needs_review",
        "requested_changes",
        "done",
        "deferred",
        "merged",
        "closed",
        "abandoned"
      ],
      "type": "string"
    },
    "Visibility": {
      "description": "§7.1 visibility scope.",
      "enum": [
        "user",
        "project",
        "workspace",
        "system"
      ],
      "type": "string"
    },
    "WorkflowInstance": {
      "description": "WorkflowInstance (12, R-7).",
      "enum": [
        "not_detected",
        "pack_available",
        "needs_personalization",
        "personalization_in_progress",
        "generated_review_required",
        "active",
        "ready_for_team_run",
        "degraded",
        "drift_detected",
        "upgrade_available",
        "archived",
        "detached"
      ],
      "type": "string"
    },
    "WorktreeGit": {
      "description": "Worktree git-sync axis (R-7). No terminal states (the overlay axis carries\nthe terminal `deleted`).",
      "enum": [
        "clean",
        "dirty",
        "untracked_files",
        "conflicts",
        "behind_base",
        "ahead_of_base"
      ],
      "type": "string"
    },
    "WorktreeOverlay": {
      "description": "Worktree lifecycle-overlay axis (R-7).",
      "enum": [
        "creating",
        "locked",
        "pr_open",
        "merged",
        "prunable",
        "deleted"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Bundles every frozen contract type so one `schema_for!` captures all value\nsets under `$defs`. Never instantiated — it exists only to drive schema gen.",
  "properties": {
    "action_request": {
      "$ref": "#/$defs/ActionRequest"
    },
    "actor_type": {
      "$ref": "#/$defs/ActorType"
    },
    "agent_team": {
      "$ref": "#/$defs/AgentTeam"
    },
    "approval": {
      "$ref": "#/$defs/Approval"
    },
    "desktop_object_kind": {
      "$ref": "#/$defs/DesktopObjectKind"
    },
    "event_envelope": {
      "$ref": "#/$defs/EventEnvelope"
    },
    "id_kind": {
      "$ref": "#/$defs/IdKind"
    },
    "project_brain": {
      "$ref": "#/$defs/ProjectBrain"
    },
    "pull_request": {
      "$ref": "#/$defs/PullRequest"
    },
    "redaction_status": {
      "$ref": "#/$defs/RedactionStatus"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity"
    },
    "session": {
      "$ref": "#/$defs/Session"
    },
    "session_started": {
      "$ref": "#/$defs/SessionStarted"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "task": {
      "$ref": "#/$defs/Task"
    },
    "visibility": {
      "$ref": "#/$defs/Visibility"
    },
    "workflow_instance": {
      "$ref": "#/$defs/WorkflowInstance"
    },
    "worktree_git": {
      "$ref": "#/$defs/WorktreeGit"
    },
    "worktree_overlay": {
      "$ref": "#/$defs/WorktreeOverlay"
    }
  },
  "required": [
    "session",
    "task",
    "worktree_git",
    "worktree_overlay",
    "pull_request",
    "workflow_instance",
    "project_brain",
    "approval",
    "action_request",
    "agent_team",
    "actor_type",
    "id_kind",
    "desktop_object_kind",
    "event_envelope",
    "source_type",
    "sensitivity",
    "visibility",
    "redaction_status",
    "session_started"
  ],
  "title": "nexusops-contract",
  "type": "object",
  "x-contract-version": "0.8.0"
}
