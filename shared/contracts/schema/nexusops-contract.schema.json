        "failed",
        "partially_succeeded",
        "rolled_back",
        "rollback_failed",
        "cancelled",
        "expired"
      ],
      "type": "string"
    },
    "ActorType": {
      "description": "The 10 canonical audit actors (R-2). Serialized as snake_case `TEXT`.",
      "enum": [
        "user",
        "project_brain",
        "action_gateway",
        "workflow_runtime",
        "local_runner",
        "session_adapter",
        "integration_syncer",
        "system",
        "remote_client",
        "automation_policy"
      ],
      "type": "string"
    },
    "AgentTeam": {
      "description": "AgentTeam (9, R-6).",
      "enum": [
        "draft",
        "starting",
        "active",
        "waiting_on_human",
        "blocked",
        "reconciling_outputs",
        "completed",
        "failed",
        "archived"
      ],
      "type": "string"
    },
    "Approval": {
      "description": "Approval (10, R-5) — split from ActionRequest; the human/policy decision axis.",
      "enum": [
        "requested",
        "previewed",
        "awaiting_approval",
        "approved",
        "denied",
        "edited",
        "auto_approved_by_policy",
        "expired",
        "cancelled",
        "escalated"
      ],
      "type": "string"
    },
    "DesktopObjectKind": {
      "description": "The 4 desktop-addendum object kinds (§5.3). Serialized snake_case.",
      "enum": [
        "local_runner",
        "event_projection",
        "device",
        "remote_client"
      ],
      "type": "string"
    },
    "IdKind": {
      "description": "The 22 shared ID kinds (§5.2). Serialized snake_case (== the ID field name).",
