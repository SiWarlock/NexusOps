        "reindex_required",
        "error"
      ],
      "type": "string"
    },
    "PullRequest": {
      "description": "PullRequest (11) — GitHub-authoritative cache (§7.2).",
      "enum": [
        "draft",
        "open",
        "checks_pending",
        "checks_failing",
        "needs_review",
        "changes_requested",
        "approved",
        "mergeable",
        "conflict",
        "merged",
        "closed"
