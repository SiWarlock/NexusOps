# Disable pnpm's pre-run dependency-status check. On this machine that check
# intermittently crashes in a spawned subprocess (same corepack signature-flake
# family as the broken `pnpm` corepack shim — see the session note / runbook).
# Deps are managed explicitly via `pnpm install`; skipping the pre-run probe
# keeps `pnpm test:run` / `pnpm typecheck` / `pnpm oxlint` reliable for CI + the
# /preflight gate.
verify-deps-before-run=false
