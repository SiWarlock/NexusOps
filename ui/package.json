{
  "name": "nexusops-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NexusOps Tauri desktop UI — projection-driven reattaching client (Phase 6).",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_NEXUSOPS_MOCK=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "bench": "vitest bench --run",
    "bench:guard": "vitest run --config vitest.bench.config.ts",
    "check:bundle": "vite build && node scripts/check-prod-bundle.mjs",
    "oxlint": "oxlint",
    "lint": "oxlint",
    "tauri": "tauri"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "json-schema-to-zod": "^2.8.1",
    "oxlint": "^1.68.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
